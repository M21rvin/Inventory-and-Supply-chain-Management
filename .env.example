# Copy to .env and fill in your values

# Cloud MySQL (Railway/PlanetScale/Clever Cloud)
DB_URL=mysql+pymysql://user:password@host:3306/ims_db

# OR Cloud PostgreSQL (Render/Supabase/Neon)
# DB_URL=postgresql://user:password@host:5432/ims_db

# JWT — generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-something-long-and-random
JWT_EXPIRY_HOURS=24

# Flask
FLASK_DEBUG=False
FLASK_ENV=production

# CORS — your frontend domain (no trailing slash)
CORS_ORIGINS=https://yourdomain.com,http://localhost:5500
